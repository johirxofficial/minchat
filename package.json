{
  "name": "minchat",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted, privacy-aware chat and calling platform with a role-based operations console",
  "author": "johirxofficial",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johirxofficial/minchat.git"
  },
  "bugs": {
    "url": "https://github.com/johirxofficial/minchat/issues"
  },
  "homepage": "https://github.com/johirxofficial/minchat#readme",
  "keywords": [
    "chat",
    "messenger",
    "webrtc",
    "socket.io",
    "self-hosted",
    "privacy",
    "express",
    "react",
    "postgresql",
    "redis"
  ],
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "migrate": "npm run migrate -w server",
    "seed:admin": "npm run seed:admin -w server",
    "cleanup": "npm run cleanup -w server",
    "test": "npm run test -w server",
    "test:e2e": "npm run test:e2e -w server",
    "seed:demo": "npm run seed:demo -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
