# ---------------------------------------------------------------------------
# MinChat configuration
#
# Copy this file to `.env` and adjust the values for your deployment.
# Never commit `.env` — it contains secrets.
#
#   cp .env.example .env
#   # generate a session secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=5050
# Bind to 127.0.0.1 when a reverse proxy (Nginx, Caddy, Docker) sits in front.
HOST=127.0.0.1
# Public origin users open in the browser. No trailing slash.
APP_ORIGIN=http://localhost:5050
# Optional: external URL if it differs from APP_ORIGIN.
# PUBLIC_URL=https://chat.example.com
# Extra allowed origins for CORS / WebSocket handshakes (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Number of reverse proxies in front of the app (1 for a single Nginx).
TRUST_PROXY=1

# --- Sessions & cookies ----------------------------------------------------
# 32+ random characters. Required.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
SESSION_TTL_DAYS=7
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Database & cache ------------------------------------------------------
DATABASE_URL=postgres://minchat:change-me@127.0.0.1:5432/minchat
DB_POOL_MAX=20
REDIS_URL=redis://127.0.0.1:6379

# Docker Compose only — the database container uses these to provision itself,
# and the app service builds DATABASE_URL from them. Ignored outside Docker.
POSTGRES_USER=minchat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=minchat

# --- Storage ---------------------------------------------------------------
# Media is stored outside the web root and served only through authorised routes.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
USER_STORAGE_QUOTA_MB=500
# Set true only when the API also serves the built client (Docker image does).
SERVE_STATIC=false

# --- Logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- WebRTC ----------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=minchat
# TURN_PASSWORD=change-me
CALL_RING_TIMEOUT_MS=45000

# --- Email -----------------------------------------------------------------
# Leave SMTP_HOST empty to run in development mode (messages are stored in the
# mail_outbox table and logged, but not delivered).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MinChat <no-reply@example.com>
# When true, development-mode deliveries are marked "sent" with a dev flag.
ALLOW_DEV_EMAIL=true

# --- Web push (optional) ---------------------------------------------------
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- First administrator ---------------------------------------------------
# Used by `npm run seed:admin`. Choose a strong, unique password.
ADMIN_USERNAME=johirxofficial
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-first-start

# --- Product ---------------------------------------------------------------
MAX_GROUP_MEMBERS=100
# Initial registration state. Can be changed later in the admin console.
REGISTRATION_OPEN=true
