    "express": "^4.21.2",
    "file-type": "^21.3.4",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "mime-types": "^2.1.35",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "pino-pretty": "^13.0.0",
