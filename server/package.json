{
  "name": "@minchat/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/scripts/migrate.js",
    "seed:admin": "node src/scripts/seed-admin.js",
    "cleanup": "node src/scripts/cleanup.js",
